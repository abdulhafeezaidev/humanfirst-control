{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "ControlPlane.Agent": "Debug"
    }
  },
  "Agent": {
    "ServiceName": "ControlPlane.Agent",
    "PipeName": "ControlPlaneAgentPipe",
    "LogDirectory": "C:\\ProgramData\\ControlPlane",
    "MaxConcurrentConnections": 10,
    "HeartbeatIntervalSeconds": 60,
    "AssignmentMode": {
      "DomainVerificationEndpoint": "",
      "DomainVerificationApiKey": ""
    }
  }
}
