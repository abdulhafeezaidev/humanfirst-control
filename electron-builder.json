{
  "appId": "com.humanfirst.control",
  "productName": "HumanFirst Control",
  "directories": {
    "output": "desktop/dist"
  },
  "files": [
    "dist/**",
    "electron/**",
    "package.json"
  ],
  "asar": true,
  "win": {
    "icon": "public/favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "icon": "public/favicon.ico",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Education",
    "maintainer": "HumanFirst <admin@humanfirst.edu>",
    "description": "Ethical AI usage control for education"
  }
}
